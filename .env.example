# Copy to .env.local on the server only. Never commit real values.
# Host must stay 127.0.0.1 — do not expose PostgreSQL publicly.

DATABASE_URL="postgresql://ambition_user:CHANGE_ME@127.0.0.1:5432/ambition_holidays?schema=public"

# Existing Orbit passkey auth (unchanged in Phase 1)
# Super-admin Orbit (/orbit-login). On production these are written to
# /var/www/ambition-holidays-cms/orbit-secrets.env during deploy (GitHub Actions secrets).
ORBIT_PASSKEY="change-me"
ORBIT_SESSION_SECRET="change-me-to-a-long-random-string"
